# NearChat Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000
API_VERSION=v1

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/nearchat?retryWrites=true&w=majority

# MongoDB Local Development (alternative)
# MONGODB_URI=mongodb://localhost:27017/nearchat

# MongoDB Options
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=secure_password_here

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis Connection String
REDIS_URL=redis://localhost:6379

# Redis Cluster (production)
# REDIS_URL=redis://redis-cluster:6379

# Redis Sentinel (high availability)
# REDIS_SENTINEL_HOSTS=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
# REDIS_SENTINEL_MASTER_NAME=mymaster

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# JWT Secret (generate a strong random string)
JWT_SECRET=your_super_secure_jwt_secret_key_here_make_it_long_and_random
JWT_REFRESH_SECRET=your_super_secure_jwt_refresh_secret_key_here

# JWT Token Expiration
JWT_ACCESS_TOKEN_EXPIRY=24h
JWT_REFRESH_TOKEN_EXPIRY=7d
JWT_ADMIN_TOKEN_EXPIRY=1h

# =============================================================================
# GOOGLE OAUTH CONFIGURATION
# =============================================================================
# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google OAuth Redirect URIs
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# =============================================================================
# AWS S3 CONFIGURATION (for file uploads)
# =============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=nearchat-uploads
AWS_S3_BUCKET_REGION=us-east-1

# AWS CloudFront Distribution (for CDN)
AWS_CLOUDFRONT_DOMAIN=your_cloudfront_domain.cloudfront.net

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
# Maximum file sizes (in bytes)
MAX_FILE_SIZE=10485760  # 10MB
MAX_IMAGE_SIZE=5242880  # 5MB
MAX_VIDEO_SIZE=52428800 # 50MB
MAX_AUDIO_SIZE=10485760 # 10MB

# Allowed file types
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/ogg
ALLOWED_AUDIO_TYPES=audio/mp3,audio/wav,audio/ogg,audio/m4a

# Upload directory
UPLOAD_DIR=./uploads

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Email templates
EMAIL_FROM=noreply@nearchat.com
EMAIL_FROM_NAME=NearChat

# =============================================================================
# PUSH NOTIFICATION CONFIGURATION
# =============================================================================
# Firebase Cloud Messaging
FCM_SERVER_KEY=your_fcm_server_key_here
FCM_PROJECT_ID=your_fcm_project_id

# Apple Push Notification Service
APN_KEY_ID=your_apn_key_id
APN_TEAM_ID=your_apn_team_id
APN_BUNDLE_ID=com.nearchat.app
APN_KEY_PATH=./certs/apn_key.p8

# =============================================================================
# PAYMENT CONFIGURATION
# =============================================================================
# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox  # or 'live'

# =============================================================================
# ANALYTICS CONFIGURATION
# =============================================================================
# Google Analytics
GA_TRACKING_ID=GA_TRACKING_ID

# Mixpanel
MIXPANEL_TOKEN=your_mixpanel_token

# Amplitude
AMPLITUDE_API_KEY=your_amplitude_api_key

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
# PM2 Configuration
PM2_PUBLIC_KEY=your_pm2_public_key
PM2_SECRET_KEY=your_pm2_secret_key

# Sentry Error Tracking
SENTRY_DSN=your_sentry_dsn

# Log Level
LOG_LEVEL=info  # debug, info, warn, error

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# CORS Configuration
CORS_ORIGIN=http://localhost:3000,https://nearchat.com
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=5

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true

# Session Configuration
SESSION_SECRET=your_session_secret_here
SESSION_MAX_AGE=86400000  # 24 hours

# =============================================================================
# WEBRTC CONFIGURATION
# =============================================================================
# TURN/STUN Servers
TURN_SERVER_URL=turn:your_turn_server.com:3478
TURN_SERVER_USERNAME=your_turn_username
TURN_SERVER_CREDENTIAL=your_turn_credential

STUN_SERVER_URL=stun:stun.l.google.com:19302

# WebRTC Configuration
WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# =============================================================================
# GEOLOCATION CONFIGURATION
# =============================================================================
# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Geocoding Service
GEOCODING_PROVIDER=google  # google, opencage, mapbox
OPENCAGE_API_KEY=your_opencage_api_key
MAPBOX_API_KEY=your_mapbox_api_key

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
# Redis Cache TTL (in seconds)
CACHE_TTL=3600  # 1 hour
USER_CACHE_TTL=1800  # 30 minutes
STORY_CACHE_TTL=900  # 15 minutes
MESSAGE_CACHE_TTL=300  # 5 minutes

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features
ENABLE_GOOGLE_OAUTH=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_PAYMENTS=true
ENABLE_ANALYTICS=true
ENABLE_WEBRTC=true
ENABLE_LIVE_STREAMING=true
ENABLE_STORY_ARCHIVING=true
ENABLE_MESSAGE_ENCRYPTION=true

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Development settings
DEBUG=false
ENABLE_SWAGGER=true
ENABLE_GRAPHQL_PLAYGROUND=false

# Test Configuration
TEST_DATABASE_URI=mongodb://localhost:27017/nearchat_test
TEST_REDIS_URL=redis://localhost:6379/1

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
# Docker Configuration
DOCKER_IMAGE_NAME=nearchat-backend
DOCKER_IMAGE_TAG=latest

# Kubernetes Configuration
K8S_NAMESPACE=nearchat
K8S_REPLICAS=3

# Load Balancer Configuration
LOAD_BALANCER_ENABLED=true
LOAD_BALANCER_ALGORITHM=round_robin

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Database Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=nearchat-backups

# =============================================================================
# CUSTOMIZATION
# =============================================================================
# App Configuration
APP_NAME=NearChat
APP_VERSION=1.0.0
APP_DESCRIPTION=Enterprise-grade social messaging platform

# Branding
BRAND_COLOR=#007AFF
BRAND_LOGO_URL=https://nearchat.com/logo.png

# Default Settings
DEFAULT_USER_PRIVACY=public
DEFAULT_STORY_VISIBILITY=nearby
DEFAULT_MESSAGE_TTL=86400  # 24 hours

# =============================================================================
# INTEGRATION KEYS
# =============================================================================
# Third-party service keys
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

SENDGRID_API_KEY=your_sendgrid_api_key

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# =============================================================================
# ENCRYPTION CONFIGURATION
# =============================================================================
# Message Encryption
ENCRYPTION_ALGORITHM=AES-256-GCM
ENCRYPTION_KEY=your_32_character_encryption_key_here

# End-to-end encryption
E2E_ENCRYPTION_ENABLED=true
E2E_KEY_ROTATION_DAYS=30

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
# Database Connection Pool
DB_POOL_SIZE=100
DB_POOL_MIN_SIZE=10

# Redis Connection Pool
REDIS_POOL_SIZE=50
REDIS_POOL_MIN_SIZE=5

# Worker Threads
WORKER_THREADS=4

# Memory Limits
MAX_MEMORY_USAGE=1024  # MB
MAX_HEAP_SIZE=1024     # MB

# =============================================================================
# MONETIZATION CONFIGURATION
# =============================================================================
# AdMob Configuration
ADMOB_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
ADMOB_BANNER_AD_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/zzzzzzzzzz
ADMOB_INTERSTITIAL_AD_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/wwwwwwwwww
ADMOB_REWARDED_AD_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/vvvvvvvvvv

# Subscription Plans
PREMIUM_MONTHLY_PRICE=9.99
PREMIUM_YEARLY_PRICE=99.99
PRO_MONTHLY_PRICE=19.99
PRO_YEARLY_PRICE=199.99

# =============================================================================
# COMPLIANCE & LEGAL
# =============================================================================
# GDPR Configuration
GDPR_ENABLED=true
GDPR_DATA_RETENTION_DAYS=2555  # 7 years
GDPR_DELETE_ANONYMIZE=true

# Privacy Policy
PRIVACY_POLICY_URL=https://nearchat.com/privacy
TERMS_OF_SERVICE_URL=https://nearchat.com/terms

# =============================================================================
# MAINTENANCE MODE
# =============================================================================
# Maintenance Configuration
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=We are currently performing maintenance. Please try again later.
MAINTENANCE_ALLOWED_IPS=127.0.0.1,::1

# =============================================================================
# WEBHOOK CONFIGURATION
# =============================================================================
# Webhook URLs
WEBHOOK_USER_REGISTRATION=https://your-webhook-url.com/user-registration
WEBHOOK_PAYMENT_SUCCESS=https://your-webhook-url.com/payment-success
WEBHOOK_PAYMENT_FAILURE=https://your-webhook-url.com/payment-failure

# Webhook Secret
WEBHOOK_SECRET=your_webhook_secret_here

# =============================================================================
# CUSTOM ENVIRONMENT VARIABLES
# =============================================================================
# Add any custom environment variables below
CUSTOM_FEATURE_FLAG=false
CUSTOM_API_KEY=your_custom_api_key